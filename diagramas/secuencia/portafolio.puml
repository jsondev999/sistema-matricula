@startuml portafolio
autonumber
skinparam SequenceMessageAlignment center

actor "Estudiante Ingresante" as Client
participant "React App" as React
participant "portafolio_upload.php (PHP / PDO)" as API
database "MySQL (InnoDB)" as DB

Client -> React: Selecciona archivo (JPG/PNG) y pulsa "Guardar"
React -> API: POST /api/portafolio_upload.php\nHeaders: BearerToken\nBody: Multipart(file, id_tipo_documento)
activate API

API -> API: Validar formato (jpg, png) y peso (max 2MB)

alt Formato y Peso Válidos
    API -> API: Almacenar archivo físico en /uploads/portafolio/
    API -> DB: INSERT INTO portafolio_documento\n(id_estudiante, id_tipo_documento, ruta_archivo, formato, peso_kb, estado)\nVALUES (?, ?, ?, ?, ?, 'ENTREGADO')\nON DUPLICATE KEY UPDATE ruta_archivo = VALUES(ruta_archivo)
    DB --> API: Confirmación de guardado
    
    API -> DB: SELECT fn_validar_requisitos_completos(id_estudiante)
    DB --> API: Requisitos Completados (TRUE / FALSE)
    
    alt 4 Documentos Completados
        API --> React: 200 OK {status: "COMPLETO", redirect: "/cola-virtual"}
        deactivate API
        React --> Client: Habilita botón "Continuar a Matrícula"
    else Faltan Documentos
        activate API
        API --> React: 200 OK {status: "INCOMPLETO", faltantes: ["Salud"]}
        deactivate API
        React --> Client: Actualiza checklist con distintivo verde
    end
else Formato o Peso Inválido
    activate API
    API --> React: 422 Unprocessable Entity ("Solo se aceptan archivos JPG/PNG de hasta 2MB")
    deactivate API
    React --> Client: Muestra mensaje de error
end
@enduml