@startuml autenticacion
autonumber
skinparam SequenceMessageAlignment center

actor "Estudiante (React)" as Client
participant "Frontend (Vercel)" as React
participant "API Router / Middleware" as API
participant "AuthController (Laravel)" as Auth
database "MySQL Workbench" as DB

Client -> React: Ingresa código y contraseña
React -> API: POST /api/v1/login {codigo, password}
API -> Auth: login(request)
Auth -> DB: SELECT id, password, es_ingresante, id_escuela\nFROM estudiante WHERE codigo = p_codigo
DB --> Auth: Retorna credenciales y perfil

alt Credenciales Válidas
    Auth -> DB: SELECT fn_validar_cronograma(id_escuela, es_ingresante)
    DB --> Auth: Cronograma Permitido (TRUE / FALSE)
    
    alt Dentro de Cronograma
        Auth -> Auth: Crear API Token (Laravel Sanctum)
        Auth --> React: 200 OK {token: BearerToken, es_ingresante}
        
        alt es_ingresante == TRUE
            React --> Client: Redirige a /portafolio
        else es_ingresante == FALSE
            React --> Client: Redirige a /cola-virtual
        end
    else Fuera de Cronograma
        Auth --> React: 403 Forbidden ("Acceso no permitido por cronograma")
        React --> Client: Muestra mensaje de error de fecha/hora
    end
else Credenciales Invalides
    Auth --> React: 401 Unauthorized ("Código o contraseña incorrecta")
    React --> Client: Muestra alerta de error
end
@enduml