@startuml autenticacion
autonumber
skinparam SequenceMessageAlignment center

actor "Estudiante" as Client
participant "Frontend (React SPA)" as React
participant "login.php (PHP Puro / PDO)" as API
database "MySQL (InnoDB)" as DB

Client -> React: Ingresa código universitario y contraseña
React -> API: POST /api/login.php\nBody: {codigo, password}
activate API

API -> DB: SELECT id_estudiante, password_hash, es_ingresante, id_escuela\nFROM estudiante WHERE codigo = ?
DB --> API: Retorna credenciales y perfil académico

alt Credenciales Válidas (password_verify)
    API -> DB: SELECT fn_validar_cronograma(id_escuela, es_ingresante)
    DB --> API: Cronograma Permitido (TRUE / FALSE)
    
    alt Dentro de Cronograma
        API -> API: Iniciar Sesión (Session Token / JWT)
        API --> React: 200 OK {token: "xyz...", es_ingresante: bool}
        deactivate API
        
        alt es_ingresante == TRUE
            React --> Client: Redirige a /portafolio
        else es_ingresante == FALSE
            React --> Client: Redirige a /cola-virtual
        end
    else Fuera de Cronograma
        activate API
        API --> React: 403 Forbidden ("Acceso no permitido por cronograma")
        deactivate API
        React --> Client: Muestra mensaje con fecha/hora de su turno
    end
else Credenciales Inválidas
    activate API
    API --> React: 401 Unauthorized ("Código o contraseña incorrectos")
    deactivate API
    React --> Client: Muestra alerta de credenciales incorrectas
end
@enduml