@startuml validacion
autonumber
skinparam SequenceMessageAlignment center

actor "Estudiante" as Client
participant "React App" as React
participant "confirmar.php (PHP / PDO)" as Controller
database "MySQL (InnoDB)" as DB

Client -> React: Clic en "Confirmar Matrícula"
React -> Controller: POST /api/confirmar.php\nBody: {id_proforma}
activate Controller

Controller -> DB: SELECT fn_validar_cruces_horario(p_id_proforma)
DB --> Controller: Cruces Detectados (TRUE / FALSE)

alt Sin Cruces de Horario
    Controller -> DB: CALL sp_confirmar_matricula(p_id_proforma, @codigo, @mensaje)
    activate DB
        DB -> DB: START TRANSACTION
        DB -> DB: UPDATE matricula SET estado = 'CONFIRMADA',\nes_editable = FALSE, fecha_confirmacion = NOW()\nWHERE id_matricula = p_id_proforma
        DB -> DB: COMMIT
        DB --> Controller: @codigo = 200, @mensaje = "Matrícula confirmada"
    deactivate DB
    
    Controller --> React: 200 OK {estado: "CONFIRMADA", mensaje: "Matrícula finalizada"}
    deactivate Controller
    React --> Client: Muestra pantalla de éxito y habilita "Descargar Ficha PDF"
    
    Client -> React: Clic en "Descargar Ficha de Matrícula (PDF)"
    React -> Controller: GET /api/generar_pdf.php?id={id_matricula}
    activate Controller
    Controller -> DB: SELECT * FROM vw_ficha_matricula WHERE id_matricula = ?
    DB --> Controller: Retorna datos consolidados de la ficha
    Controller -> Controller: Renderizar Ficha en PDF (FPDF / DomPDF en PHP)
    Controller --> React: 200 OK (Stream application/pdf)
    deactivate Controller
    React --> Client: Descarga o abre el archivo Ficha_Matricula.pdf
else Existe Cruce de Horario
    activate Controller
    Controller --> React: 400 Bad Request ("Tiene asignaturas en conflicto de horario")
    deactivate Controller
    React --> Client: Pinta de rojo los bloques en conflicto y bloquea confirmación
end
@enduml