@startuml autenticacion
left to right direction
skinparam packageStyle rectangle

actor "Estudiante" as est

rectangle "Autenticación y Control de Acceso" {
    usecase "Iniciar Sesión" as UC_Login
    usecase "Validar Credenciales (Código y Contraseña)" as UC_ValidarCred
    usecase "Validar Cronograma de Acceso\n(Facultad y Condición)" as UC_Cronograma
    usecase "Mostrar Alerta Fuera de Cronograma" as UC_AlertaCronograma
    
    usecase "Cerrar Sesión" as UC_Logout
    
    usecase "Solicitar Restablecimiento de Contraseña" as UC_ReqRecup
    usecase "Enviar Enlace a Correo Institucional" as UC_SendEmail
    usecase "Actualizar Contraseña" as UC_UpdatePass
}

est --> UC_Login
est --> UC_Logout
est --> UC_ReqRecup

UC_Login .> UC_ValidarCred : <<include>>
UC_Login .> UC_Cronograma : <<include>>
UC_Cronograma <. UC_AlertaCronograma : <<extend>>

UC_ReqRecup .> UC_SendEmail : <<include>>
UC_SendEmail .> UC_UpdatePass : <<include>>
@enduml