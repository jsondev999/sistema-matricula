@startuml cola virtual
left to right direction
skinparam packageStyle rectangle

actor "Estudiante" as est

rectangle "Cola Virtual y Control de Concurrencia" {
    usecase "Ingresar a Sala de Espera Virtual" as UC_IngresarCola
    usecase "Visualizar Posición y Tiempo Estimado" as UC_VerTurno
    usecase "Habilitar Turno de Matrícula" as UC_TurnoActivo
    usecase "Ingresar a Panel de Matrícula" as UC_IngresarMatricula
    usecase "Iniciar Temporizador (5 Minutos)" as UC_Timer
    usecase "Cancelar Reserva Temporal por Expiración" as UC_CancelarReserva
}

est --> UC_IngresarCola
est --> UC_IngresarMatricula

UC_IngresarCola .> UC_VerTurno : <<include>>
UC_VerTurno .> UC_TurnoActivo : <<include>>

UC_IngresarMatricula .> UC_Timer : <<include>>
UC_Timer <. UC_CancelarReserva : <<extend>> : Expira 5 min
@enduml