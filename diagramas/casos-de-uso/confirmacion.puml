@startuml confirmacion
left to right direction
skinparam packageStyle rectangle

actor "Estudiante" as est

rectangle "Confirmación y Emisión de Ficha" {
    usecase "Confirmar Selección de Matrícula" as UC_Confirmar
    usecase "Validar Estado de Pago Previo" as UC_ValidarPago
    usecase "Cambiar Estado de PROFORMA a CONFIRMADA" as UC_CambiarEstado
    usecase "Bloquear Edición de Matrícula" as UC_BloquearEdicion
    usecase "Generar Ficha Oficial de Matrícula" as UC_GenFicha
    usecase "Descargar Ficha en Formato PDF" as UC_DescargarPDF
}

est --> UC_Confirmar
est --> UC_DescargarPDF

UC_Confirmar .> UC_ValidarPago : <<include>>
UC_Confirmar .> UC_CambiarEstado : <<include>>
UC_CambiarEstado .> UC_BloquearEdicion : <<include>>
UC_Confirmar .> UC_GenFicha : <<include>>

UC_DescargarPDF .> UC_GenFicha : <<include>>
@enduml